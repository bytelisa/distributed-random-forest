# --- STAGE 1: Build the Go binary ---
FROM golang:alpine AS builder

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=0 GOOS=linux go build -o master_exec cmd/master/master_main.go

# --- STAGE 2: Create the final image ---
FROM alpine:3.20

WORKDIR /root/

# TLS roots, needed to talk to real S3 over https
RUN apk add --no-cache ca-certificates

# Copy the Go binary from the builder stage
COPY --from=builder /app/master_exec .

# Copy configs
COPY configs ./configs

EXPOSE 8080

# Command to run the Go executable
CMD ["./master_exec"]
